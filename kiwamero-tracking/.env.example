# Copy these keys into .env for local development; never commit real credentials.
DATABASE_URL="file:./prisma/dev.db"
BETTER_AUTH_URL="http://localhost:3002"
# Generate a random 32+ character value for local/prod separately.
BETTER_AUTH_SECRET=""

# Get a key from https://api.henrikdev.xyz/dashboard/api-keys
HENRIK_API_KEY=""

# Discord Developer Portal; redirect URL:
# http://localhost:3002/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Comma-separated Discord user IDs allowed to use the owner-only API.
# Add real values locally and as a Cloudflare secret; do not commit them.
OWNER_DISCORD_IDS=""
