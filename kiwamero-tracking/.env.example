# Copy these keys into .env for local development; never commit real credentials.
# Local sqlite file used when no Cloudflare D1 context is available
# (`node --test`, scripts). In `next dev` the Miniflare D1 binding takes over.
DATABASE_URL="file:./db/dev.db"
BETTER_AUTH_URL="http://localhost:3002"
# Generate a random 32+ character value for local/prod separately.
BETTER_AUTH_SECRET=""

# Get a key from https://api.henrikdev.xyz/dashboard/api-keys
HENRIK_API_KEY=""
# Optional: extra keys, comma-separated; duplicates are removed.
# Shared D1 budgets/cooldowns apply before all upstream calls.
HENRIK_API_KEYS=""
# Shared D1 rolling-minute budgets; defaults match the observed Standard plan.
# "key": independent per-key quotas (verify with the provider before deployment).
# "shared": all configured keys share one account/application budget.
HENRIK_QUOTA_SCOPE="key"
HENRIK_KEY_RPM="30"
HENRIK_BACKGROUND_RPM="20"

# Discord Developer Portal; redirect URL:
# http://localhost:3002/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Comma-separated Discord user IDs allowed to view the site and use owner APIs.
# Add real values locally and as a Cloudflare secret; do not commit them.
OWNER_DISCORD_IDS=""

# Shared secret for POST /api/cron/watch and /api/cron/audit.
# Unset in `next dev` disables the check for local testing only.
CRON_SECRET=""

# Per-credential requests/minute for the owner-only developer API
# (/api/valorant/* and /api/keys). Default 60.
API_RATE_LIMIT_PER_MIN="60"
# Public origin used in Discord notifications (defaults to the production domain).
APP_URL="http://localhost:3002"
