{
  "name": "kiwamero-tracking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/*.test.ts\"",
    "check:watch-worker": "node tools/check-watch-worker.cjs",
    "check:profile-worker": "node tools/check-profile-worker.cjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:watch-worker && npm run check:profile-worker && npm run build",
    "build:worker": "node -r ./tools/fs-symlink-fallback.cjs tools/build-worker.cjs build",
    "preview:worker": "node -r ./tools/fs-symlink-fallback.cjs node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "scrub:bundle": "node tools/scrub-deploy-bundle.cjs",
    "deploy": "node tools/deploy.cjs"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.7",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "satori": "0.32.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.153.0"
  }
}
