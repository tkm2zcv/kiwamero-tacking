{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiwamero-tracking",
  // Custom entry: minute audit queue + hourly watch cycle (see src/worker.js).
  "main": "src/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kiwamero-tracking",
      "database_id": "a8f05616-d3ce-4c36-8674-7c5890204561"
    }
  ],
  // Custom domain (requires kiwamero.dev zone on this account).
  "routes": [{ "pattern": "tracking.kiwamero.dev", "custom_domain": true }],
  // Background queue every minute; worker keeps notifications hourly.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_URL": "https://tracking.kiwamero.dev",
    "BETTER_AUTH_URL": "https://tracking.kiwamero.dev"
  }
}
